# Keep the build context limited to the project files used by Dockerfile.airflow.
# Compose mounts these runtime directories directly from the host, so excluding
# them here does not affect Airflow's access to data, configuration, logs, or DAGs.
airflow/
artifacts/
configs/
data/
models/
tests/

