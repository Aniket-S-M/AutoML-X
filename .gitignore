.venv/
venv/
__pycache__/
.pytest_cache/
.env
.env.*
*.env
!.env.example
*.pyc
*.egg-info/

# Local generated data and artifacts. Keep lightweight curated samples tracked under
# data/samples/ or models/samples/ if the academic project needs them.
data/raw/
data/processed/
models/artifacts/
models/registry/

# Local Airflow logs and generated model artifacts.
/airflow/logs/*
!/airflow/logs/.gitkeep
/airflow/metadata/*
!/airflow/metadata/.gitkeep
/airflow/metadata-backup-*/
/airflow/metadata-migration-stage-*/
/artifacts/*
!/artifacts/.gitkeep
/data/*
!/data/.gitkeep
